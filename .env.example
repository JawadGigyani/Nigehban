# Copy to .env and fill in. Every variable uses the NIGEHBAN_ prefix.

NIGEHBAN_ENVIRONMENT=development

# Database: SQLite locally (default). For Supabase use the Postgres URL:
# NIGEHBAN_DATABASE_URL=postgresql+psycopg://user:password@host:5432/postgres
# NIGEHBAN_DATABASE_URL=sqlite:///data/nigehban.db

# LLM via LangChain. Primary provider: groq | gemini | openai | custom
NIGEHBAN_LLM_PROVIDER=groq
NIGEHBAN_LLM_API_KEY=
# Tried in order when the primary fails or is rate limited (JSON list)
# NIGEHBAN_LLM_FALLBACK_PROVIDERS=["gemini"]
# Provider keys (the unprefixed names GROQ_API_KEY / GEMINI_API_KEY / OPENAI_API_KEY also work)
GEMINI_API_KEY=
# Extra keys, comma-separated, no spaces needed. Used in turn when a key is rate limited;
# a limited key is skipped for NIGEHBAN_LLM_COOLDOWN_S (120 s) or, for daily limits,
# NIGEHBAN_LLM_DAILY_COOLDOWN_S (3600 s).
# NIGEHBAN_GROQ_API_KEYS=gsk_second,gsk_third
# NIGEHBAN_GEMINI_API_KEYS=second_key,third_key
# NIGEHBAN_GEMINI_MODEL=gemini-3.5-flash-lite  (gemini-2.5-flash is closed to new accounts)
# Optional overrides for the primary provider
# NIGEHBAN_LLM_MODEL=openai/gpt-oss-120b
# NIGEHBAN_LLM_BASE_URL=
# json_schema (strict, for models that support it) or json_object
# NIGEHBAN_LLM_JSON_MODE=json_schema

# Contact privacy. Generate with:
#   python -c "from backend.app.db import generate_keys; print(generate_keys())"
NIGEHBAN_CONTACT_ENCRYPTION_KEY=
NIGEHBAN_CONTACT_HASH_KEY=

# Authority board login
NIGEHBAN_BOARD_PASSWORD=

# Alert policy
# NIGEHBAN_ALERT_FALSE_ALARM_TARGET_PER_SEASON=2.5

# PDMA scraper (keep the interval at 2 s or more)
# NIGEHBAN_PDMA_REQUEST_INTERVAL_S=2.0

# Alert rules (defaults: alert at high or above, up to 2 days ahead)
# NIGEHBAN_ALERT_MIN_LEVEL=high
# NIGEHBAN_ALERT_MAX_LEAD_DAYS=2
# NIGEHBAN_RIVER_FLAG_RETURN_PERIOD=5
# Protects POST /internal/run-cycle; the cron job sends it as the X-Internal-Token header.
# Required in production. Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
# NIGEHBAN_INTERNAL_TOKEN=
# Web push (browser notifications). Generate with: python -m backend.app.alerts.channels --vapid
# NIGEHBAN_VAPID_PUBLIC_KEY=
# NIGEHBAN_VAPID_PRIVATE_KEY=
# Telegram: private development channel only (blocked in Pakistan)
# NIGEHBAN_TELEGRAM_BOT_TOKEN=

# Routes to safety: free OpenRouteService key (optional; built-in OSM router otherwise)
# NIGEHBAN_ORS_API_KEY=

# Urdu voice alerts (ElevenLabs). Key permissions: Text to Speech = Access; everything else = No access.
# Only the eleven_v3 / eleven_v4 models speak Urdu.
# NIGEHBAN_ELEVENLABS_API_KEY=
# NIGEHBAN_ELEVENLABS_VOICE_ID=JBFqnCBsd6RMkjVDRZzb
# NIGEHBAN_ELEVENLABS_MODEL=eleven_v3

# SMS via the free open-source "SMS Gateway for Android" app (an Android phone + SIM sends the SMS).
# Cloud mode: credentials shown in the app under "Cloud Server".
# NIGEHBAN_SMS_GATEWAY_URL=https://api.sms-gate.app/3rdparty/v1
# NIGEHBAN_SMS_GATEWAY_USERNAME=
# NIGEHBAN_SMS_GATEWAY_PASSWORD=

# WhatsApp Cloud API (Meta): free only with the test number and up to 5 verified recipients.
# NIGEHBAN_WHATSAPP_TOKEN=
# NIGEHBAN_WHATSAPP_PHONE_NUMBER_ID=
# NIGEHBAN_WHATSAPP_TEMPLATE=

# SMS.to (free credits on signup; supports Pakistan). Used for SMS when set.
# NIGEHBAN_SMSTO_API_KEY=
# NIGEHBAN_SMSTO_SENDER_ID=Nigehban

# Twilio free trial: SMS to verified numbers + WhatsApp Sandbox (used instead of the adapters above when set)
# NIGEHBAN_TWILIO_ACCOUNT_SID=
# NIGEHBAN_TWILIO_AUTH_TOKEN=
# NIGEHBAN_TWILIO_SMS_FROM=+1...
# NIGEHBAN_TWILIO_WHATSAPP_FROM=+14155238886

# NASA Earthdata token for IMERG (approve "NASA GESDISC DATA ARCHIVE" under Applications -> Authorized Apps)
# NIGEHBAN_EARTHDATA_TOKEN=

# Deployment: private Hugging Face dataset with the runtime data (see Dockerfile)
# NIGEHBAN_RUNTIME_DATA_REPO=<user>/nigehban-runtime
# HF_TOKEN=
